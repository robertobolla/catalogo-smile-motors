# Copiar a .env.local y completar. Nunca commitear .env.local.
#
# Son todas VITE_*: van al navegador. Este proyecto no tiene funciones de
# servidor, así que acá no hay ni puede haber secretos (nada de service role
# keys ni API keys de correo — eso vive en `tienda/` y en `admin/`).

# --- Catálogo -------------------------------------------------------------
# De dónde salen productos y precios. Por defecto el admin de producción; se
# cambia solo para probar contra un admin local (http://localhost:3001/...).
# Si no contesta, el sitio lo dice y ofrece reintentar: no hay copia local.
VITE_CATALOG_API=https://admin.smilemotors.online/api/public/store

# --- Analítica -----------------------------------------------------------
# Solo tráfico y fichas vistas. No hay evento de conversión: sin carrito ni
# canal de contacto, no hay nada que convertir.
VITE_GA_ID=G-R09KVKHD09
VITE_META_PIXEL_ID=1877960819554160
